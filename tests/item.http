@endpoint = http://localhost:3000/api/v1/items

###
# @name postAnItem


POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: 12345

{
  "type": "lost",
  "category": "Stationery",
  "itemName": "Pen",
  "colour": "red",
  "brand": "Bic",
  "location": "D2010",
  "dateFound": "2026-10-11",
  "notes": "I lost my red bic pen in the office",
  "status": "open"
}


###

@newItemID = {{postAnItem.response.body._id}}
###
GET  {{endpoint}}/{{newItemID}} HTTP/3.0
content-type: application/json




###
GET  {{endpoint}}/{{newItemID}} HTTP/3.0

content-type: application/json


###

DELETE  {{endpoint}}/{{newItemID}} HTTP/3.0
content-type: application/json

###

PUT  {{endpoint}}/{{newItemID}} HTTP/3.0
content-type: application/json
