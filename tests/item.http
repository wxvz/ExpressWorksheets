@endpoint = http://localhost:3000/api/v1/items

###
# @name postAnItem


POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: 12345

{
  "type": "lost",
  "category": "Stationery",
  "itemName": "Pen",
  "colour": "black",
  "brand": "Bic",
  "location": "D2010",
  "dateFound": "2026-10-11",
  "notes": "I lost my black bic pen in the office",
  "status": "open"
}


###

@newItemID = {{postAnItem.response.body._id}}


###
# @name InvalidItem

POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: 12345

{
  "type": "found",
  "category": "",
  "itemName": "Pen",
  "colour": "red",
  "brand": "Bic",
  "location": "D2010",
  "dateFound": "2026-10-11",
  "notes": "I found a red bic pen in the office",
  "status": "open"
}


### Get all items
GET  {{endpoint}}/ HTTP/3.0
content-type: application/json
x-api-key: 12345


### Get a specific item
GET  {{endpoint}}/{{newItemID}} HTTP/3.0
content-type: application/json
x-api-key: 12345

###
# 
GET {{endpoint}}/123456789012 HTTP/1.1
content-type: application/json
x-api-key: 12345

### 

DELETE  {{endpoint}}/{{newItemID}} HTTP/3.0
content-type: application/json
x-api-key: 12345

###

DELETE {{endpoint}}/123456789012 HTTP/1.1
content-type: application/json
x-api-key: 12345

